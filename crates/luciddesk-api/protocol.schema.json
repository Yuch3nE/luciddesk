{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luciddesk:control:1",
  "title": "LucidDesk control protocol v1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "request_id",
        "command"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "command": {
          "enum": [
            "status",
            "capabilities",
            "workspace.get",
            "settings.get",
            "font.list",
            "pane.list",
            "pane.get",
            "item.list",
            "plan.preview",
            "plan.apply",
            "request.get",
            "monitor.list",
            "folder.get",
            "search.get",
            "startup.get"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "pane": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[1-9][0-9]*$"
        },
        "unassigned": {
          "type": "boolean"
        },
        "data_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "token": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "plan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/plan"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "command": {
                "const": "plan.preview"
              }
            }
          },
          "then": {
            "required": [
              "plan"
            ],
            "properties": {
              "plan": {
                "$ref": "#/$defs/plan"
              }
            }
          },
          "else": {
            "properties": {
              "plan": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "plan.apply"
              }
            }
          },
          "then": {
            "required": [
              "token"
            ],
            "properties": {
              "token": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "else": {
            "properties": {
              "token": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "enum": [
                  "pane.get",
                  "request.get",
                  "folder.get",
                  "search.get"
                ]
              }
            }
          },
          "then": {
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          },
          "else": {
            "properties": {
              "id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "enum": [
                  "pane.get",
                  "folder.get",
                  "search.get"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "item.list"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "pane",
                "unassigned"
              ],
              "properties": {
                "pane": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                "unassigned": {
                  "const": true
                }
              }
            }
          },
          "else": {
            "properties": {
              "pane": {
                "type": "null"
              },
              "unassigned": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "request_id",
        "ok",
        "context",
        "data",
        "error"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "request_id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "context": {
          "type": [
            "object",
            "null"
          ]
        },
        "data": {},
        "error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "retryable": {
                  "type": "boolean"
                }
              }
            }
          ]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance_id",
        "state_version",
        "inventory_version",
        "topology_token"
      ],
      "properties": {
        "instance_id": {
          "type": "string",
          "minLength": 1
        },
        "state_version": {
          "type": "string",
          "minLength": 1
        },
        "inventory_version": {
          "type": "string",
          "minLength": 1
        },
        "topology_token": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "base",
        "operations"
      ],
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "base": {
          "$ref": "#/$defs/context"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "ref",
                  "title"
                ],
                "properties": {
                  "op": {
                    "const": "pane.create"
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "pane.update"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "locked": {
                    "type": "boolean"
                  },
                  "auto_hide": {
                    "type": "boolean"
                  },
                  "collapsed": {
                    "type": "boolean"
                  },
                  "always_on_top": {
                    "type": "boolean"
                  },
                  "auto_compact": {
                    "type": "boolean"
                  },
                  "align_icons_to_grid": {
                    "type": "boolean"
                  }
                },
                "minProperties": 3
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "item_ids"
                ],
                "properties": {
                  "op": {
                    "const": "item.assign"
                  },
                  "item_ids": {
                    "type": "array",
                    "maxItems": 10000,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  "pane_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pane_ref": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "pane_id"
                    ],
                    "properties": {
                      "pane_id": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]*$"
                      },
                      "pane_ref": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "required": [
                      "pane_ref"
                    ],
                    "properties": {
                      "pane_ref": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pane_id": {
                        "type": "null"
                      }
                    }
                  }
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id",
                  "item_ids"
                ],
                "properties": {
                  "op": {
                    "const": "item.reorder"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "item_ids": {
                    "type": "array",
                    "maxItems": 10000,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "pane.remove"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "release_items": {
                    "type": "boolean",
                    "default": false
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "item_ids"
                ],
                "properties": {
                  "op": {
                    "const": "item.release"
                  },
                  "item_ids": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 10000,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "values"
                ],
                "properties": {
                  "op": {
                    "const": "settings.update"
                  },
                  "values": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id",
                  "monitor_id",
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "properties": {
                  "op": {
                    "const": "pane.geometry"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "monitor_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0
                  },
                  "width": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id",
                  "into_pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "tab.merge"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "into_pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "tab.select"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id",
                  "pane_ids"
                ],
                "properties": {
                  "op": {
                    "const": "tab.reorder"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "pane_ids": {
                    "type": "array",
                    "minItems": 2,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$"
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "tab.detach"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "ref",
                  "title",
                  "path"
                ],
                "properties": {
                  "op": {
                    "const": "folder.create"
                  },
                  "ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "minProperties": 3,
                "properties": {
                  "op": {
                    "const": "folder.update"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "list_view": {
                    "type": "boolean"
                  },
                  "sort_column": {
                    "enum": [
                      "name",
                      "modified",
                      "type",
                      "size"
                    ]
                  },
                  "descending": {
                    "type": "boolean"
                  },
                  "column_widths": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "exclusiveMaximum": 1
                    }
                  },
                  "visible_columns": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "name",
                        "modified",
                        "type",
                        "size"
                      ]
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id",
                  "path"
                ],
                "properties": {
                  "op": {
                    "const": "folder.navigate"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "folder.back"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "folder.home"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id",
                  "query"
                ],
                "properties": {
                  "op": {
                    "const": "search.query"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "query": {
                    "type": "string",
                    "maxLength": 32767
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "search.refresh"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "search.more"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "enabled",
                  "expected_status"
                ],
                "properties": {
                  "op": {
                    "const": "startup.set"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "expected_status": {
                    "enum": [
                      "off",
                      "enabled",
                      "disabled_by_windows"
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id",
                  "icon_columns"
                ],
                "properties": {
                  "op": {
                    "const": "pane.fit"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "icon_columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "monitor_id",
                  "columns",
                  "icon_columns"
                ],
                "properties": {
                  "op": {
                    "const": "pane.arrange"
                  },
                  "monitor_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 256,
                      "items": {
                        "type": "string",
                        "pattern": "^[1-9][0-9]*$"
                      }
                    }
                  },
                  "icon_columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id",
                  "target_pane_id",
                  "side"
                ],
                "properties": {
                  "op": {
                    "const": "pane.snap"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "target_pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "side": {
                    "enum": [
                      "left",
                      "right",
                      "top",
                      "bottom"
                    ]
                  },
                  "align": {
                    "enum": [
                      "start",
                      "center",
                      "end"
                    ],
                    "default": "start"
                  },
                  "icon_columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "folder.fit"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "icon_columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 64
                  },
                  "max_rows": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "folder.refresh"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id"
                ],
                "properties": {
                  "op": {
                    "const": "pane.sort"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "descending": {
                    "type": "boolean",
                    "default": false
                  },
                  "sort_column": {
                    "type": "string",
                    "enum": [
                      "name",
                      "modified",
                      "type",
                      "size"
                    ],
                    "default": "name"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "op",
                  "pane_id",
                  "item_id"
                ],
                "properties": {
                  "op": {
                    "const": "item.position"
                  },
                  "pane_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  "item_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "row": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10000
                  },
                  "x": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000
                  },
                  "y": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1000000
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "column",
                      "row"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "x"
                          ]
                        },
                        {
                          "required": [
                            "y"
                          ]
                        }
                      ]
                    }
                  },
                  {
                    "required": [
                      "x",
                      "y"
                    ],
                    "not": {
                      "anyOf": [
                        {
                          "required": [
                            "column"
                          ]
                        },
                        {
                          "required": [
                            "row"
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    }
  }
}
