// Keep this ID in sync with APP_ICON in src/app_icon.rs.
1 ICON "assets/luciddesk.ico"

#include <winver.h>

1 VERSIONINFO
FILEVERSION @VERSION_NUMERIC@
PRODUCTVERSION @VERSION_NUMERIC@
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Yuchen95\0"
            VALUE "FileDescription", "@DESCRIPTION@\0"
            VALUE "FileVersion", "@VERSION_STRING@\0"
            VALUE "InternalName", "@BINARY@\0"
            VALUE "OriginalFilename", "@BINARY@.exe\0"
            VALUE "ProductName", "LucidDesk\0"
            VALUE "ProductVersion", "@VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
