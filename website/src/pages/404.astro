---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
---
<Layout noindex title="页面未找到 · LucidDesk">
  <section class="mx-auto max-w-3xl px-6 py-28 text-center">
    <p class="text-sm text-muted">404 / NOT FOUND</p>
    <h1 class="my-6 text-4xl font-bold">这里暂时没有内容。</h1>
    <p class="mb-8 text-muted">回到首页，重新找到你的工作区。</p>
    <Button href="/" text="返回首页" icon="chevron-right" />
  </section>
</Layout>
