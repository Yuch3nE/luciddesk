---
import ChangelogAccordion, { ChangelogBody, type ChangelogEntry } from '~/components/ChangelogAccordion';
import { changeType, type ChangeType } from '~/lib/change-types';
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import { localeOf, localizedPath } from '~/lib/i18n';
import { releasesByLocale, PAGE_SIZE, releaseDate, releaseId, inlineNote } from '~/content/changelog';
interface Props { pageNumber?: number }
const {pageNumber = 1} = Astro.props;
const lang = localeOf(Astro.url.pathname);
const en = lang === 'en';
const path = (value: string) => localizedPath(value, lang);
const releases = releasesByLocale[lang];
const totalPages = Math.ceil(releases.length / PAGE_SIZE);
const visible = releases.slice((pageNumber - 1) * PAGE_SIZE, pageNumber * PAGE_SIZE);
const pagePath = (n: number) => path(n === 1 ? '/changelog/' : `/changelog/page/${n}/`);
const title = en ? 'Changelog' : '更新日志';
const typesFor = (release: typeof releases[number]) => {
  const counts = new Map<ChangeType, number>();
  release.groups.forEach(group => group.items.forEach(item => { const type = changeType(group.title, item); counts.set(type, (counts.get(type) ?? 0) + 1); }));
  return [...counts];
};
const entries: ChangelogEntry[] = visible.map(release => ({
  version: release.version,
  id: releaseId(release.version),
  date: release.date,
  dateLabel: release.date ? releaseDate(release.date, lang) : en ? 'Feature baseline · Not a standalone release' : '功能基线 · 未单独发布',
  latest: release === releases[0],
  introduction: release.introduction.map(inlineNote),
  counts: typesFor(release),
  groups: release.groups.map(group => ({title: group.title, items: group.items.map(item => ({html:inlineNote(item), type:changeType(group.title,item)}))})),
}));
const description = en ? 'New features, improvements, and fixes in LucidDesk. See what changed in every version.' : '了解 LucidDesk 每个版本的新功能、体验改进与问题修复。';
---
<Layout title={`${title}${pageNumber > 1 ? ` · ${pageNumber}` : ''} · LucidDesk`} description={description}>
  <div class="mx-auto max-w-4xl px-5 py-12 sm:px-8 lg:py-16">
    <header class="mb-6 max-w-2xl">

      <h1 class="text-3xl font-bold tracking-tight text-heading sm:text-4xl">{title}</h1>


    </header>
    <p class="mb-6 text-sm text-muted">{en ? `Page ${pageNumber} of ${totalPages}` : `第 ${pageNumber} / ${totalPages} 页`}</p>

    <ChangelogAccordion entries={entries} lang={lang} client:load/>
    <noscript>{entries.map(entry => <section class="mb-6 rounded-2xl border border-line p-6"><h2 class="mb-5 text-xl font-semibold">v{entry.version}</h2><ChangelogBody entry={entry} lang={lang}/></section>)}</noscript>

    <nav aria-label={en ? 'Changelog pages' : '更新日志分页'} class="mt-8 flex flex-wrap items-center justify-between gap-4">
      {pageNumber > 1 ? <Button text={en ? 'Newer updates' : '较新的更新'} href={pagePath(pageNumber - 1)}/> : <span/>}
      {pageNumber < totalPages && <Button text={en ? 'Older updates' : '更早的更新'} href={pagePath(pageNumber + 1)} icon="chevron-right"/>}
    </nav>
  </div>
</Layout>
