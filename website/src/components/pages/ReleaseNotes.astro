---
import { ChangelogBody, type ChangelogEntry } from '~/components/ChangelogAccordion';
import { changeType } from '~/lib/change-types';
import Layout from '~/layouts/PageLayout.astro';
import { Badge } from '~/components/ui/badge';
import { localeOf, localizedPath } from '~/lib/i18n';
import { releasesByLocale, releaseDate, releaseId, inlineNote } from '~/content/changelog';
interface Props { version: string }
const { version } = Astro.props;
const lang = localeOf(Astro.url.pathname);
const en = lang === 'en';
const path = (value: string) => localizedPath(value, lang);
const releases = releasesByLocale[lang];
const index = releases.findIndex(release => release.version === version);
const release = releases[index];
const title = en ? `What's new in v${version}` : `v${version} 更新内容`;
const entry: ChangelogEntry = {
  version, id: releaseId(version), date: release.date,
  dateLabel: release.date ? releaseDate(release.date, lang) : en ? 'Feature baseline · Not a standalone release' : '功能基线 · 未单独发布',
  latest: index === 0, introduction: release.introduction.map(inlineNote),
  groups: release.groups.map(group => ({title: group.title, items: group.items.map(item => ({html: inlineNote(item), type:changeType(group.title,item)}))})),
};
---
<Layout title={`${title} · LucidDesk`} description={en ? `All features, improvements, and fixes recorded for LucidDesk ${version}.` : `查看 LucidDesk ${version} 的全部功能改进与问题修复。`}>
  <article class="release-page mx-auto max-w-6xl px-5 py-10 sm:px-8 lg:py-14">
    <nav class="mb-8" aria-label={en ? 'Breadcrumb' : '当前位置'}><a class="release-permalink" href={path('/changelog/')}><span aria-hidden="true">←</span>{en ? 'All updates' : '全部更新'}</a></nav>
    <header class="release-page-header">
      <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-muted">
        {index === 0 && <Badge className="border-primary/15 bg-primary/10 text-primary dark:text-blue-300">{en ? 'Latest version' : '最新版本'}</Badge>}
        {release.date ? <time datetime={release.date}>{entry.dateLabel}</time> : <span>{entry.dateLabel}</span>}
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-heading sm:text-4xl">{title}</h1>
      <nav class="release-jump-links" aria-label={en ? 'In this release' : '本次更新目录'}>
        {entry.groups.map((group, i) => <a href={`#${entry.id}-section-${i}`}>{group.title}</a>)}
      </nav>
    </header>
    <div class="release-card release-detail"><ChangelogBody entry={entry} lang={lang} headingLevel={2}/></div>
    <aside class="release-update-note">
      <p>{en ? 'Before updating, exit LucidDesk and back up your layout. Keep the data folder when updating a portable copy.' : '更新前请退出 LucidDesk 并备份布局；便携版请保留原有 data 文件夹。'}</p>
      <a class="release-permalink" href={path('/installation/#updates')}>{en ? 'Read the update guide' : '查看更新步骤'} <span aria-hidden="true">→</span></a>
    </aside>
    <nav class="release-adjacent" aria-label={en ? 'Adjacent versions' : '相邻版本'}>
      {releases[index-1] ? <a href={path(`/changelog/${releases[index-1].version}/`)}><span class="text-sm text-muted">← {en ? 'Newer version' : '较新版本'}</span><strong>v{releases[index-1].version}</strong></a> : <span/>}
      {releases[index+1] && <a class="text-right" href={path(`/changelog/${releases[index+1].version}/`)}><span class="text-sm text-muted">{en ? 'Older version' : '较早版本'} →</span><strong>v{releases[index+1].version}</strong></a>}
    </nav>
  </article>
</Layout>
