---
import Section from '~/components/ui/Section.astro';
import Button from '~/components/ui/Button.astro';
import {
  LayoutGrid, FolderOpen, Search, WandSparkles, ArrowRight, Sun, Moon,
  MousePointer2, Folder, FileText, ChevronDown, ChevronRight, Ellipsis, ArrowLeft, Check, GripVertical
} from 'lucide-react';
import { localeOf } from '~/lib/i18n';
const en = localeOf(Astro.url.pathname) === 'en';
const pick = (zh: string, english: string) => en ? english : zh;

const features = [
  {
    id: 'panels',
    Icon: LayoutGrid,
    wide: true,
    title: pick('按项目收纳，按习惯摆放', 'A place for every project'),
    description: pick(
      '把文件、文件夹和快捷方式收进桌面面板，用标签页区分不同任务。每个面板均可独立设置图标、列表或纯图标视图，支持自动排列、自由摆放、锁定，以及直接拖入 Windows Terminal。',
      'Collect files, folders, and shortcuts into desktop panels organized by tabs. Customize icon, list, or icon-only view per panel—with auto-arrange, free placement, panel locking, and direct drag-and-drop into Windows Terminal.'
    ),
    note: pick('收纳仅保存引用，不会移动或删除原文件。', 'Panels store icon references only—original files never move.'),
    href: '/features/#panels',
  },
  {
    id: 'classify',
    Icon: WandSparkles,
    wide: false,
    title: pick('自动分类，一键整理桌面', 'Auto-classify with one click'),
    description: pick(
      '按扩展名、关键字、正则表达式或图标类型设定规则，规则表直观呈现匹配条件。通过「一键整理」先预览去向再应用，开启自动整理后新图标也会自动归位。',
      'Route icons by extension, keyword, regex, or icon type, with inline condition summaries right in the rules table. Preview every move with Organize now, or sort newly added icons automatically.'
    ),
    note: pick('支持内置模板、拖拽或 Alt+↑/↓ 排序与撤销删除，原文件保留在原位。', 'Includes built-in templates, drag or Alt+↑/↓ reordering, and undo—originals stay in place.'),
    href: '/features/#classify',
  },
  {
    id: 'folders',
    Icon: FolderOpen,
    wide: false,
    title: pick('常用目录，抬眼直达', 'Your folders, right on the desktop'),
    description: pick(
      '把下载、素材和活跃项目目录直接映射到桌面。文件变动自动刷新，面板内双击进入子目录、按 Alt + ← 返回上级，少切几个资源管理器窗口。',
      'Pin downloads, assets, and active project folders straight to your desktop. Contents refresh automatically—double-click into subfolders and press Alt + Left to go back without juggling Explorer windows.'
    ),
    note: pick('文件夹面板直接操作真实目录，拖入或删除会作用于原文件。', 'Folder panels work directly on real directories—drops copy files and deletes affect originals.'),
    href: '/features/#folders',
  },
  {
    id: 'search',
    Icon: Search,
    wide: true,
    title: pick('即搜即得，打开前先预览', 'Find it. Preview it. Open it.'),
    description: pick(
      '接入 Everything 按文件名或查询语法极速检索本机文件，彩色图标一目了然；选中任意文件按空格，即可调用 PowerToys Peek 或 QuickLook 预览内容。',
      'Search local files instantly with Everything using filenames or query syntax and full-color file icons. Select any file and press Space to preview with PowerToys Peek or QuickLook.'
    ),
    note: pick('需另行安装 Everything 及 Peek 或 QuickLook，并在设置中开启。', 'Requires Everything and Peek or QuickLook, installed separately and enabled in Settings.'),
    href: '/features/#search',
  },
];

const classifyRules = [
  { target: pick('工作文档', 'Documents'), summary: pick('文件 · pdf, docx · 报告', 'File · pdf, docx · report'), enabled: true },
  { target: pick('设计素材', 'Design'), summary: 'png, jpg, svg, webp', enabled: true },
  { target: pick('常用工具', 'Tools'), summary: pick('快捷方式 · lnk, url', 'Shortcut · lnk, url'), enabled: false },
];

const materials = [
  { label: pick('纯色', 'Solid'), active: false },
  { label: pick('亚克力', 'Acrylic'), active: true },
  { label: 'Mica', active: false },
  { label: 'Mica Alt', active: false },
];
---
<Section id="features">
  <div class="mb-9 flex flex-wrap items-end justify-between gap-5">
    <div>
      <p class="section-eyebrow mb-4">{pick('日常使用', 'EVERYDAY WORKSPACE')}</p>
      <h2 class="text-balance font-heading text-3xl font-bold tracking-tight text-heading md:text-4xl">
        {pick('从收纳到寻找，都更顺手。', 'Less searching. More doing.')}
      </h2>
    </div>
    <Button href="/features/" variant="link" class="px-0 text-primary dark:text-blue-300" text={pick('查看全部功能', 'View all features')} icon="chevron-right"/>
  </div>

  <div class="feature-grid">
    {features.map((feature, index) => (
      <article data-motion class:list={['feature-story', { 'feature-wide': feature.wide, 'feature-reverse': index === 3 }]}>
        <div class="feature-copy">
          <div class="mb-4 flex items-center gap-2.5 text-primary dark:text-blue-300">
            <span class="flex size-9 items-center justify-center rounded-xl bg-primary/10 dark:bg-blue-400/15">
              <feature.Icon size={19} aria-hidden="true"/>
            </span>
            <span class="text-xs font-semibold tracking-widest opacity-80">0{index + 1}</span>
          </div>
          <h3 class="text-balance text-2xl font-semibold leading-snug text-heading">{feature.title}</h3>
          <p class="mt-3.5 text-sm leading-7 text-muted">{feature.description}</p>
          <a href={feature.href} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary dark:text-blue-300">
            {pick('了解更多', 'Learn more')}<ArrowRight size={15} aria-hidden="true"/>
          </a>
          {feature.wide && <p class="feature-note wide-note">{feature.note}</p>}
        </div>

        <div class:list={['feature-demo', `demo-${index}`]} role="img" aria-label={`${feature.title} · ${pick('功能操作示意，非实际截图', 'Feature illustration, not a screenshot')}`}>
          {index === 0 && (
            <div class="demo-window">
              <div class="demo-title demo-tab-header">
                <div class="demo-tabs">
                  <span class="selected">{pick('工作项目', 'Projects')}</span>
                  <span>{pick('常用工具', 'Tools')}</span>
                  <span>{pick('归档', 'Archive')}</span>
                </div>
                <span class="demo-controls"><ChevronDown size={14}/><Ellipsis size={14}/></span>
              </div>
              <div class="demo-icons">
                {[pick('设计素材', 'Design'), pick('项目文档', 'Documents'), pick('参考资料', 'Resources'), pick('工作计划', 'Work plan')].map((name, i) => (
                  <div class="demo-icon-item">
                    <span class="demo-icon-box">
                      {i < 2
                        ? <Folder size={28} strokeWidth={1.6} className="demo-folder"/>
                        : <FileText size={28} strokeWidth={1.6} className="demo-document"/>}
                    </span>
                    <span>{name}</span>
                  </div>
                ))}
              </div>
              <div class="demo-footer-bar">
                <span>{pick('独立视图：图标 · 列表 · 纯图标', 'Per-panel view: Icon · List · Icon-only')}</span>
              </div>
            </div>
          )}

          {index === 1 && (
            <div class="demo-window">
              <div class="demo-title">
                <span class="flex items-center gap-2"><WandSparkles size={14} className="text-primary dark:text-blue-300"/>{pick('规则管理', 'Manage rules')}</span>
                <span class="demo-pill-badge">{pick('预览优先', 'Preview first')}</span>
              </div>
              <div class="demo-rule-head">
                <span>{pick('目标分组', 'Target group')}</span>
                <span>{pick('匹配条件', 'Conditions')}</span>
                <span class="text-right">{pick('启用', 'Enabled')}</span>
              </div>
              <div class="demo-rules">
                {classifyRules.map(rule => (
                  <div class:list={['demo-rule-row', { 'is-disabled': !rule.enabled }]}>
                    <span class="demo-rule-target">
                      <GripVertical size={12} className="text-muted/60 shrink-0"/>
                      <ChevronRight size={12} className="text-muted shrink-0"/>
                      <span class="truncate">{rule.target}</span>
                    </span>
                    <span class="demo-rule-summary">{rule.summary}</span>
                    <span class:list={['demo-switch', { 'is-on': rule.enabled }]} aria-hidden="true"><span></span></span>
                  </div>
                ))}
              </div>
              <div class="demo-footer-bar justify-between">
                <span class="flex items-center gap-1.5 text-primary dark:text-blue-300 font-medium">
                  <Check size={13}/>{pick('一键整理 · 17 项待归类', 'One-click · 17 items ready')}
                </span>
                <span class="text-muted">{pick('新图标自动归位', 'Auto-sort new')}</span>
              </div>
            </div>
          )}

          {index === 2 && (
            <div class="demo-window">
              <div class="demo-title demo-folder-title">
                <ArrowLeft size={14}/>
                <span class="flex items-center justify-center gap-1.5"><FolderOpen size={14} className="text-primary dark:text-blue-300"/>{pick('项目资料', 'Project files')}</span>
                <Ellipsis size={14}/>
              </div>
              <div class="demo-columns">
                <span>{pick('文件名', 'Name')}</span>
                <span>{pick('大小', 'Size')}</span>
              </div>
              {[
                { name: pick('设计素材', 'Design assets'), size: '—', folder: true },
                { name: pick('产品说明.pdf', 'Product brief.pdf'), size: '2.4 MB', folder: false },
                { name: pick('会议记录.docx', 'Meeting notes.docx'), size: '128 KB', folder: false },
              ].map(row => (
                <div class="demo-file">
                  <span class="demo-file-name">
                    {row.folder
                      ? <Folder size={18} strokeWidth={1.6} className="demo-folder"/>
                      : <FileText size={18} strokeWidth={1.6} className="demo-document"/>}
                    <span class="demo-label">{row.name}</span>
                  </span>
                  <span class="demo-size">{row.size}</span>
                </div>
              ))}
              <div class="demo-footer-bar">
                <span>{pick('文件变化后自动刷新 · Alt + ← 返回上级', 'Auto-refreshes on change · Alt + ← to go back')}</span>
              </div>
            </div>
          )}

          {index === 3 && (
            <div class="demo-window">
              <div class="demo-search">
                <Search size={15} className="text-primary dark:text-blue-300"/>
                <span class="font-mono text-xs text-heading">ext:pdf {pick('项目计划', 'roadmap')}</span>
                <span class="ml-auto rounded bg-surface px-1.5 py-0.5 text-[10px] text-muted">Everything</span>
              </div>
              <div class="demo-file demo-result selected">
                <FileText size={26} strokeWidth={1.6} className="demo-document"/>
                <div class="result-copy">
                  <span class="demo-label font-medium text-heading">{pick('项目计划.pdf', 'Project roadmap.pdf')}</span>
                  <span class="result-path">{pick('文档 / 工作项目', 'Documents / Projects')}</span>
                </div>
                <span class="result-type">PDF · 2.4 MB</span>
              </div>
              <div class="demo-preview-hint">
                <kbd>Space</kbd>
                <span>{pick('呼出 Peek / QuickLook 预览', 'Preview with Peek or QuickLook')}</span>
                <span class="ml-auto hidden sm:inline text-[10px] text-muted"><kbd>Ctrl</kbd> + <kbd>Enter</kbd> {pick('定位', 'Reveal')}</span>
              </div>
            </div>
          )}
        </div>

        {!feature.wide && <p class="feature-note">{feature.note}</p>}
      </article>
    ))}
  </div>
</Section>

<Section id="appearance">
  <div class="rounded-3xl border border-line bg-elevated/85 p-6 shadow-sm sm:p-10 lg:grid lg:grid-cols-[1.05fr_1fr] lg:items-center lg:gap-16 lg:p-12">
    <div data-motion>
      <p class="section-eyebrow mb-4">{pick('外观与专注', 'APPEARANCE & FOCUS')}</p>
      <h2 class="font-heading text-3xl font-bold leading-snug tracking-tight text-heading md:text-4xl">
        {pick('你的桌面，随你定义。', 'Make yourself at home.')}
      </h2>
      <p class="mt-4 text-sm leading-7 text-muted">
        {pick(
          '自由切换浅色或深色主题，搭配纯色、亚克力、Mica 与 Mica Alt 材质；细致调节圆角、字体、吸附间距与标签栏对齐。需要专注时，双击桌面空白处即可隐去全部图标与面板。',
          'Switch between light and dark themes with Solid, Acrylic, Mica, or Mica Alt backdrops. Fine-tune corners, fonts, snap gaps, and tab alignment—then double-click empty desktop space to clear distractions anytime.'
        )}
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        {materials.map(m => (
          <span class:list={[
            'inline-flex items-center rounded-lg border px-2.5 py-1 text-xs font-medium',
            m.active
              ? 'border-primary/30 bg-primary/10 text-primary dark:border-blue-400/30 dark:bg-blue-400/15 dark:text-blue-300'
              : 'border-line bg-surface text-muted'
          ]}>
            {m.label}
          </span>
        ))}
      </div>
      <p class="mt-4 text-xs leading-6 text-muted">
        {pick('Mica 系列材质需要 Windows 11，实际显示效果随系统与壁纸变化。', 'Mica materials require Windows 11. Appearance varies with your system and wallpaper.')}
      </p>
      <a href="/features/#focus" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary dark:text-blue-300">
        {pick('了解外观与专注', 'Explore appearance and focus')}<ArrowRight size={15} aria-hidden="true"/>
      </a>
    </div>

    <div data-motion class="mt-8 grid grid-cols-2 gap-4 lg:mt-0" aria-label={pick('浅色与深色外观示意', 'Light and dark appearance illustrations')}>
      {[false, true].map(dark => (
        <div class:list={[
          'motion-card relative overflow-hidden rounded-2xl border p-4 sm:p-5',
          dark
            ? 'border-slate-700/80 bg-[radial-gradient(circle_at_20%_15%,rgb(59_130_246/.24),transparent_55%),linear-gradient(145deg,#0f172a,#1e293b)] text-slate-100 shadow-lg shadow-black/25'
            : 'border-slate-200/90 bg-[radial-gradient(circle_at_20%_15%,rgb(96_165_250/.22),transparent_55%),linear-gradient(145deg,#ffffff,#e8eff8)] text-slate-800 shadow-sm'
        ]}>
          <div class="flex items-center justify-between">
            <span class:list={[
              'flex size-8 items-center justify-center rounded-lg',
              dark ? 'bg-blue-400/15 text-blue-300' : 'bg-blue-600/10 text-blue-600'
            ]}>
              {dark ? <Moon size={16}/> : <Sun size={16}/>}
            </span>
            <span class:list={['text-xs font-semibold', dark ? 'text-slate-200' : 'text-slate-700']}>
              {dark ? pick('深色 · 亚克力', 'Dark · Acrylic') : pick('浅色 · Mica', 'Light · Mica')}
            </span>
          </div>
          <div class:list={[
            'mt-4 rounded-xl border p-3 backdrop-blur-md',
            dark ? 'border-white/12 bg-slate-900/65 shadow-inner' : 'border-white/90 bg-white/80 shadow-xs'
          ]} aria-hidden="true">
            <div class:list={['mb-2.5 flex items-center justify-between border-b pb-2', dark ? 'border-white/10' : 'border-slate-200/80']}>
              <span class:list={['rounded px-1.5 py-0.5 text-[9px] font-semibold', dark ? 'bg-blue-400/20 text-blue-200' : 'bg-blue-600/10 text-blue-700']}>
                {pick('工作', 'Work')}
              </span>
              <span class:list={['h-1.5 w-4 rounded-full', dark ? 'bg-slate-600' : 'bg-slate-300']}></span>
            </div>
            <div class="grid grid-cols-3 gap-2">
              {[0, 1, 2].map(i => (
                <div class="flex flex-col items-center gap-1.5">
                  <span class:list={[
                    'flex size-7 items-center justify-center rounded-lg',
                    dark ? 'bg-white/6' : 'bg-slate-100/90'
                  ]}>
                    {i === 0
                      ? <Folder size={15} strokeWidth={1.6} className="illustration-folder"/>
                      : <FileText size={15} strokeWidth={1.6} className="illustration-document"/>}
                  </span>
                  <span class:list={['h-1 w-6 rounded-full', dark ? 'bg-slate-600' : 'bg-slate-300']}></span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
      <div class="col-span-2 flex items-center justify-center gap-2 rounded-xl border border-line bg-surface/80 px-4 py-2.5 text-xs font-medium text-muted">
        <MousePointer2 size={14} className="text-primary dark:text-blue-300"/>
        <span>{pick('双击桌面空白处隐藏，再次双击恢复原状', 'Double-click empty desktop to hide. Double-click again to restore.')}</span>
      </div>
    </div>
  </div>
</Section>

<style>
.feature-grid {
  display: grid;
  gap: 20px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}
.feature-story {
  min-width: 0;
  padding: 28px;
  overflow: hidden;
  border: 1px solid var(--aw-color-line);
  border-radius: 24px;
  background: var(--aw-color-surface-elevated);
  box-shadow: 0 10px 30px -24px rgb(15 23 42 / .18);
}
:global(.dark) .feature-story {
  box-shadow: 0 14px 36px -24px rgb(0 0 0 / .6), inset 0 1px 0 rgb(255 255 255 / .04);
}
.feature-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}
.feature-copy > a {
  margin-top: auto;
  padding-top: 16px;
}
.feature-story:not(.feature-wide) {
  display: grid;
  grid-template-rows: subgrid;
  grid-row: span 3;
  row-gap: 20px;
}
.feature-wide {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: 1fr 1.05fr;
  align-items: center;
  gap: 36px;
  padding: 32px;
}
.feature-wide .feature-copy > a {
  margin-top: 18px;
  padding-top: 0;
}
.feature-reverse .feature-demo {
  order: -1;
}
.feature-demo {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: center;
  background: transparent;
}
.feature-wide .feature-demo {
  align-items: center;
}

.demo-window {
  width: 100%;
  max-width: 470px;
  border: 1px solid var(--aw-color-line);
  border-radius: 14px;
  overflow: hidden;
  background: var(--illustration-panel);
  box-shadow: 0 14px 30px -20px rgb(15 23 42 / .2), 0 2px 6px -3px rgb(15 23 42 / .07);
  color: var(--aw-color-text-heading);
  font-size: 12px;
}
:global(.dark) .demo-window {
  box-shadow: 0 16px 34px -20px rgb(0 0 0 / .65), inset 0 1px 0 rgb(255 255 255 / .05);
}
.demo-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 14px;
  border-bottom: 1px solid var(--aw-color-line);
  font-weight: 600;
}
.demo-tab-header {
  gap: 8px;
  padding: 9px 10px;
}
.demo-tabs {
  display: flex;
  flex: 1;
  min-width: 0;
  gap: 4px;
  color: var(--aw-color-text-muted);
  font-size: 11px;
  font-weight: 400;
}
.demo-tabs span {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 5px 9px;
  border-radius: 7px;
}
.demo-tabs .selected {
  font-weight: 600;
}
.demo-controls {
  display: flex;
  flex-shrink: 0;
  gap: 8px;
  color: var(--aw-color-text-muted);
}
.selected {
  background: color-mix(in srgb, var(--aw-color-primary) 11%, transparent);
  color: var(--aw-color-primary);
}
:global(.dark) .selected {
  background: rgb(59 130 246 / .18);
  color: #93c5fd;
}

.demo-icons {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  padding: 22px 14px;
}
.demo-icon-item {
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 8px;
  font-size: 11px;
  text-align: center;
  color: var(--aw-color-text-default);
}
.demo-icon-box {
  display: grid;
  place-items: center;
  width: 48px;
  height: 44px;
  border-radius: 10px;
  background: color-mix(in srgb, var(--aw-color-surface) 75%, transparent);
}

.demo-pill-badge {
  padding: 2px 8px;
  border-radius: 9999px;
  background: color-mix(in srgb, var(--aw-color-primary) 10%, transparent);
  color: var(--aw-color-primary);
  font-size: 10px;
  font-weight: 600;
}
:global(.dark) .demo-pill-badge {
  color: #93c5fd;
}
.demo-rule-head {
  display: grid;
  grid-template-columns: 1.05fr 1.35fr 2.2rem;
  gap: 8px;
  padding: 7px 14px;
  border-bottom: 1px solid color-mix(in srgb, var(--aw-color-line) 75%, transparent);
  background: color-mix(in srgb, var(--aw-color-surface) 45%, transparent);
  font-size: 10px;
  font-weight: 600;
  color: var(--aw-color-text-muted);
}
.demo-rules {
  padding: 4px 10px;
  display: flex;
  flex-direction: column;
}
.demo-rule-row {
  display: grid;
  grid-template-columns: 1.05fr 1.35fr 2.2rem;
  align-items: center;
  gap: 8px;
  padding: 9px 4px;
  font-size: 11px;
}
.demo-rule-row + .demo-rule-row {
  border-top: 1px solid color-mix(in srgb, var(--aw-color-line) 55%, transparent);
}
.demo-rule-target {
  display: flex;
  align-items: center;
  gap: 4px;
  min-width: 0;
  font-weight: 600;
  color: var(--aw-color-text-heading);
}
.demo-rule-row.is-disabled .demo-rule-target {
  color: var(--aw-color-text-muted);
}
.demo-rule-summary {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 10.5px;
  color: var(--aw-color-text-muted);
}
.demo-switch {
  justify-self: end;
  width: 26px;
  height: 14px;
  padding: 2px;
  border-radius: 9999px;
  border: 1px solid var(--aw-color-line);
  background: var(--aw-color-surface);
  display: inline-flex;
  align-items: center;
}
.demo-switch > span {
  width: 8px;
  height: 8px;
  border-radius: 9999px;
