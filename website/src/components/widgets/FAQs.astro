---
import { localeOf } from '~/lib/i18n';
import { ArrowRight } from 'lucide-react';
const en = localeOf(Astro.url.pathname) === 'en';
import Section from '~/components/ui/Section.astro';
import FAQAccordion from '~/components/FAQAccordion';
interface Props { title: string; subtitle?: string; tagline?: string; id?: string; items: { title: string; description: string }[]; }
const {title, subtitle, tagline, items = [], id} = Astro.props;
---
<Section id={id}>
  <div class="grid gap-10 border-t border-line pt-12 lg:grid-cols-[0.68fr_1.32fr] lg:gap-16">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="section-eyebrow mb-4">{tagline || (en ? 'GOOD TO KNOW' : '使用之前')}</p>
      <h2 class="font-heading text-3xl font-bold tracking-tight text-heading">{title}</h2>
      <p class="mt-4 text-sm leading-7 text-muted">{subtitle || (en ? 'Key details on file safety, auto-classification, packages, and privacy—up front.' : '关于文件安全、自动分类、版本选择与隐私，先把关键细节说清楚。')}</p>
      <a href="/guide/" class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-primary dark:text-blue-300">
        {en ? 'Read the user guide' : '阅读使用指南'}
        <ArrowRight size={15} aria-hidden="true"/>
      </a>
    </div>
    <div class="min-w-0 rounded-2xl border border-line bg-elevated px-5 sm:px-7">
      <FAQAccordion items={items} client:load />
    </div>
  </div>
  <noscript><dl class="mx-auto max-w-3xl space-y-5">{items.map(item => <div><dt class="font-semibold">{item.title}</dt><dd class="mt-2 text-sm text-muted" set:html={item.description}/></div>)}</dl></noscript>
</Section>
