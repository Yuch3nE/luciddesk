---
import Button from '~/components/ui/Button.astro';
interface Props {
  tagline: string;
  actions: { text: string; href: string; variant?: 'primary' | 'secondary'; icon?: string }[];
}
const { tagline, actions } = Astro.props;
---
<section class="hero-backdrop mx-auto max-w-6xl px-5 pt-10 pb-8 sm:px-8 md:pt-14 md:pb-12">
  <div class="lg:grid lg:grid-cols-[0.88fr_1.12fr] lg:items-center lg:gap-12">
    <div data-motion-initial="sequence" class="min-w-0 pb-10 text-center lg:pb-0 lg:text-left">
      <div data-motion-stage class="mb-5">
        <p class="section-eyebrow">{tagline}</p>
      </div>
      <h1 data-motion-stage class="mb-5 text-balance font-heading text-4xl font-bold leading-[1.18] tracking-tight text-heading sm:text-5xl xl:text-[3.5rem]"><slot name="title"/></h1>
      <p data-motion-stage class="mx-auto mb-7 max-w-xl text-pretty text-base leading-relaxed text-muted md:text-lg lg:mx-0"><slot name="subtitle"/></p>
      <div data-motion-stage class="mx-auto flex max-w-xs flex-col justify-center gap-3 sm:max-w-lg sm:flex-row lg:mx-0 lg:justify-start">
        {actions.map(action => <Button {...action} class="w-full sm:w-auto"/>)}
      </div>
      <div data-motion-stage><slot name="content"/></div>
    </div>
    <div data-motion-initial="illustration" class="mx-auto w-full min-w-0 max-w-2xl"><slot name="image"/></div>
  </div>
  <slot name="footer"/>
</section>
