---
import { localeOf, translator, localizedPath } from '~/lib/i18n';
const lang = localeOf(Astro.url.pathname);
const t = translator(lang);

import RepositoryLink from "~/components/RepositoryLink";
---
<footer class="border-t border-line"><div class="flex flex-col sm:flex-row mx-auto max-w-6xl items-center justify-between gap-6 px-5 py-8 sm:px-8"><aside><a href={localizedPath("/", lang)} class="flex items-center gap-2 text-lg font-bold"><img src="/assets/app-icon.png" width="28" height="28" alt="">LucidDesk</a><p class="mt-2 text-xs text-muted">{t("桌面有序，专注自在。 · MIT 开源许可")}</p></aside><nav class="flex flex-wrap items-center justify-center gap-6 text-xs"><RepositoryLink lang={lang} /><a class="underline underline-offset-4" href="https://github.com/Yuch3nE/luciddesk/issues">{t("反馈问题")}</a><a class="underline underline-offset-4" href={localizedPath("/privacy/", lang)}>{t("应用隐私")}</a><a class="underline underline-offset-4" href={localizedPath("/changelog/", lang)}>{lang === "en" ? "Changelog" : "更新日志"}</a></nav></div></footer>
