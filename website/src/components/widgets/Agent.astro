---
import { localeOf, translator, localizedPath } from '~/lib/i18n';
const lang = localeOf(Astro.url.pathname);
const en = lang === 'en';
const t = translator(lang);

import { Sparkles, Terminal } from "lucide-react";
import Button from '~/components/ui/Button.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Section from '~/components/ui/Section.astro';

const steps = [
  {
    title: t('读取工作区'),
    detail: en ? 'Inspect live panels, icon assignments, and window layout—never stale IDs.' : '读取当前面板、图标归属与窗口布局，始终基于最新状态。',
  },
  {
    title: t('生成计划并预览'),
    detail: en ? 'Generate a change summary and full diff preview before touching the desktop.' : '生成变更摘要与差异预览，核对无误后再提交。',
  },
  {
    title: t('应用并检查结果'),
    detail: en ? 'Apply approved changes and verify results—plus manage backups via CLI.' : '应用确认的方案并校验结果，同样支持备份、导出与恢复配置。',
  },
];
---
<Section id="agent">
  <div class="grid items-center gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16">
    <div>
      <SectionHeading tagline="AGENT & CLI" title={t("你决定怎么摆，<br/>Agent 帮你动手。")} align="left"/>
      <p class="max-w-lg text-base leading-relaxed text-muted">
        {t("把整理需求交给 Agent：按项目分组、调整面板大小、安排工作区。通过配套 Skill 与 CLI，先了解现状、预览改动，再应用到桌面。")}
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <Button href={localizedPath("/agent/", lang)} text={t("了解 Agent 联动")} variant="secondary" icon="chevron-right"/>
      </div>
      <p class="mt-4 text-xs leading-6 text-muted">
        {en
          ? 'Works with your external agent via bundled CLI & Skill. No built-in LLM or API key required.'
          : '需使用外部 Agent 并启用应用内 CLI 控制；不内置大模型，无需配置 API 密钥。'}
      </p>
    </div>

    <div data-motion="sequence" class="min-w-0 rounded-3xl border border-line bg-elevated p-6 shadow-sm sm:p-8">
      <div class="mb-5 flex items-center justify-between gap-2 text-xs font-semibold tracking-wider text-primary dark:text-blue-300">
        <span class="inline-flex items-center gap-2">
          <Sparkles size={15} aria-hidden="true"/>
          {en ? 'FROM REQUEST TO WORKSPACE' : '从一句话，到有序桌面'}
        </span>
        <span class="rounded-full border border-line bg-surface px-2.5 py-0.5 font-mono text-[10px] font-medium tracking-normal text-muted">
          --dry-run --json
        </span>
      </div>

      <blockquote data-motion-stage class="rounded-2xl rounded-tl-sm border border-primary/18 bg-primary/[0.04] p-5 text-base font-medium leading-relaxed text-heading dark:border-blue-400/20 dark:bg-blue-400/[0.06] sm:text-lg">
        {t("“把工作文件放在左边，")}<br/>{t("常用工具放在右边。”")}
      </blockquote>

      <div data-motion-stage class="mt-4 flex items-center gap-2.5 overflow-x-auto rounded-xl border border-line bg-page/90 px-4 py-3 font-mono text-xs text-default shadow-inner">
        <Terminal size={14} className="shrink-0 text-primary dark:text-blue-300" aria-hidden="true"/>
        <code class="whitespace-nowrap text-heading">luciddesk-cli pane create --title "{en ? 'Work' : '工作'}" --dry-run --json</code>
      </div>

      <ol class="relative mt-6 space-y-5 before:pointer-events-none before:absolute before:top-3.5 before:bottom-3.5 before:left-[13px] before:w-px before:bg-line">
        {steps.map(({ title, detail }, index) => (
          <li data-motion-stage class="agent-step relative flex items-start gap-3.5">
            <span class="relative z-10 mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-primary/25 bg-elevated text-xs font-semibold text-primary shadow-xs dark:border-blue-400/30 dark:text-blue-300" aria-hidden="true">0{index + 1}</span>
            <div class="min-w-0 pb-1">
              <h3 class="text-sm font-semibold text-heading">{title}</h3>
              <p class="mt-1 text-xs leading-6 text-muted">{detail}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</Section>
