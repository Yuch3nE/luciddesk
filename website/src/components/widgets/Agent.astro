---
import { localeOf, translator, localizedPath } from '~/lib/i18n';
const lang = localeOf(Astro.url.pathname);
const t = translator(lang);

import { Sparkles } from "lucide-react";
import Button from '~/components/ui/Button.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import Section from '~/components/ui/Section.astro';
const steps = [
  t('读取工作区'),
  t('生成计划并预览'),
  t('应用并检查结果'),
];
---
<div>
  <Section id="agent">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_1.05fr] lg:gap-20">
      <div>
        <SectionHeading tagline="AGENT" title={t("你决定怎么摆，<br/>Agent 帮你动手。")} align="left"/>
        <p class="max-w-lg text-base text-muted">{t("把整理需求交给 Agent：按项目分组、调整面板大小、安排工作区。通过配套 Skill 与 CLI，先了解现状、预览改动，再应用到桌面。")}</p>
        <Button href={localizedPath("/agent/", lang)} text={t("了解 Agent 联动")} icon="chevron-right" class="mt-8"/>
        <p class="mt-4 text-xs text-muted">{t("需使用外部 Agent，并启用应用中的 CLI 控制。")}</p>
      </div>
      <div data-motion="sequence" class="min-w-0 rounded-3xl bg-surface p-6 sm:p-9">
        <div class="mb-5 flex items-center gap-2 text-xs font-semibold tracking-widest text-primary dark:text-blue-300"><Sparkles size={16}/>{lang === "en" ? "FROM REQUEST TO WORKSPACE" : "从一句话，到有序桌面"}</div>

        <blockquote data-motion-stage class="rounded-2xl rounded-tl-sm border border-line bg-page p-5 text-lg font-medium leading-relaxed text-heading">{t("“把工作文件放在左边，")}<br/>{t("常用工具放在右边。”")}</blockquote>
        <ol class="mt-7 space-y-0">
          {steps.map((title, index) => <li data-motion-stage class="agent-step flex items-center gap-4 border-b border-line py-4 last:border-0">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-semibold text-primary dark:text-blue-300" aria-hidden="true">0{index+1}</span>
            <h3 class="text-sm font-medium text-heading">{title}</h3>
          </li>)}
        </ol>


      </div>
    </div>
  </Section>
</div>
