---

import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  badge,

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const { ...imageProps } = typeof image === 'object' && image ? image : { src: '', alt: '' };

---

<section class="relative not-prose" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
  </div>
  <div class="relative max-w-6xl mx-auto px-5 sm:px-8">

    <div class="pt-12 pb-4 md:pt-16 md:pb-6">
      <div data-motion="sequence" class="text-center pb-9 md:pb-12 max-w-4xl mx-auto">
        {
          badge && (
            <span data-motion-stage class="inline-block mb-4 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-primary dark:bg-primary/25 dark:text-blue-200">
              {badge}
            </span>
          )
        }
        {
          tagline && (
            <p data-motion-stage
              class="mb-5 text-xs text-primary dark:text-blue-300 font-semibold tracking-widest"
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1 data-motion-stage
              class="text-4xl sm:text-5xl md:text-6xl font-bold leading-[1.25] tracking-tight text-balance mb-5 font-heading text-heading"
              set:html={title}
            />
          )
        }
        <div class="max-w-2xl mx-auto">
          {
            subtitle && (
              <p data-motion-stage
                class="text-base md:text-lg text-muted mb-8"
                set:html={subtitle}
              />
            )
          }
          {
            actions && (
              <div data-motion-stage class="max-w-xs sm:max-w-lg m-auto flex flex-nowrap flex-col sm:flex-row sm:justify-center gap-4">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <div data-motion-stage><Fragment set:html={content} /></div>}
      </div>
      <div
        class=""
      >
        {
          image && (
            <div data-motion="illustration" class="relative m-auto max-w-5xl">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <img src={imageProps.src} alt={imageProps.alt || ""} class="mx-auto w-full rounded-2xl" />
              )}
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>
