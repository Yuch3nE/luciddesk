---
import { localeOf, translator, localizedPath } from '~/lib/i18n';
const lang = localeOf(Astro.url.pathname);
const t = translator(lang);

import { Badge } from "~/components/ui/badge";
import Button from '~/components/ui/Button.astro';
import Section from '~/components/ui/Section.astro';
const editions = [
  {title:t('安装版'), recommended:true, filename:'setup.exe', description:t('跟随安装向导完成设置，带有开始菜单和卸载入口。适合固定使用的电脑。')},
  {title:t('便携版'), recommended:false, filename:'portable.zip', description:t('解压即可运行，配置保存在程序目录的 data 文件夹。适合希望配置随程序携带的场景。')},
];
---
<Section id="download">
  <div class="overflow-hidden rounded-3xl border border-line bg-surface p-6 sm:p-10 lg:p-12">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.05fr] lg:gap-16">
      <div>
        <p class="mb-4 text-xs font-semibold tracking-widest text-primary dark:text-blue-300">{t("开始使用")}</p>
        <h2 class="text-3xl font-bold leading-snug tracking-tight text-heading sm:text-4xl">{lang === 'en' ? 'A clearer desktop starts here.' : <><span class="block">从今天开始，</span><span class="block">给桌面留点余地。</span></>}</h2>
        <p class="mt-5 text-sm leading-7 text-muted">{lang === 'en' ? 'Requires Windows 10 1809 (build 17763) or later, or Windows 11 · x64.' : '最低要求：Windows 10 1809（Build 17763）或更新版本，或 Windows 11 · x64。'}<br/>{lang === 'en' ? 'Free and open source. No account needed.' : '免费、开源，无需注册账号。'}</p>
        <Button variant="primary" text={t("前往 GitHub 下载")} icon="download" href="https://github.com/Yuch3nE/luciddesk/releases/latest" class="mt-7"/>
        <p class="mt-4 max-w-sm text-xs leading-6 text-muted">{lang === 'en' ? 'On the release page, open Assets and choose a package using the filename below.' : '在发布页展开 Assets，按文件名后缀选择安装包。'}</p>
      </div>
      <div class="divide-y divide-line rounded-2xl border border-line bg-page px-6">
        {editions.map(({title,recommended,filename,description}) => <div class="py-6">
          <div class="flex flex-wrap items-center justify-between gap-3"><h3 class="text-lg font-semibold text-heading">{title}</h3>{recommended && <Badge className="rounded-full border-0 bg-primary/10 px-2.5 py-1 text-[11px] text-primary dark:text-blue-300">{t("日常使用推荐")}</Badge>}</div>
          <p class="mt-3 text-sm leading-7 text-muted">{description}</p>
          <code class="mt-4 inline-block rounded-md border border-line bg-surface px-2.5 py-1 text-xs text-heading">{filename}</code>
        </div>)}
      </div>
    </div>
    <div class="mt-9 flex flex-col justify-between gap-4 border-t border-primary/15 pt-6 text-xs text-muted sm:flex-row">
      <p>{t("也提供普通 ZIP 版，版本区别见安装与更新指南。")}</p>
      <div class="flex flex-wrap gap-5"><a class="underline underline-offset-4" href={localizedPath("/changelog/", lang)}>{lang === "en" ? "What’s new" : "查看更新内容"}</a><a class="underline underline-offset-4" href={localizedPath("/installation/#updates", lang)}>{t("安装与更新指南")}</a></div>
    </div>
  </div>
</Section>
