---
import { localeOf, translator, localizedPath } from '~/lib/i18n';
const lang = localeOf(Astro.url.pathname);
const en = lang === 'en';
const t = translator(lang);

import { Badge } from "~/components/ui/badge";
import { Check, Package, FolderArchive, HardDrive } from "lucide-react";
import Button from '~/components/ui/Button.astro';
import Section from '~/components/ui/Section.astro';

const editions = [
  {
    Icon: Package,
    title: t('安装版'),
    recommended: true,
    filename: '*-setup.exe',
    configPath: '%LOCALAPPDATA%\\LucidDesk',
    description: t('跟随安装向导完成设置，带有开始菜单和卸载入口。适合固定使用的电脑。'),
  },
  {
    Icon: HardDrive,
    title: t('便携版'),
    recommended: false,
    filename: '*-portable.zip',
    configPath: en ? 'App folder / data' : '程序目录 / data',
    description: t('解压即可运行，配置保存在程序目录的 data 文件夹。适合希望配置随程序携带的场景。'),
  },
  {
    Icon: FolderArchive,
    title: en ? 'Standard ZIP' : '普通 ZIP',
    recommended: false,
    filename: '*.zip',
    configPath: '%LOCALAPPDATA%\\LucidDesk',
    description: en
      ? 'No installer required—extract and run while keeping settings in your Windows app data folder.'
      : '免安装解压即用，程序文件与本地用户配置分开保存，适合偏好绿色解压的用户。',
  },
];

const perks = en
  ? [
      'Windows 10 1809 (build 17763)+ or Windows 11 · x64',
      'Locally verified signed updates—upgrade in place',
      'Free, MIT open source, no account, 7 UI languages',
    ]
  : [
      '支持 Windows 10 1809（Build 17763）及以上 / Windows 11 · x64',
      '支持应用内签名更新，本地验签后原位升级',
      '免费、开源（MIT），无需注册账号，内置 7 种界面语言',
    ];
---
<Section id="download">
  <div class="download-shell overflow-hidden rounded-3xl border border-line bg-elevated p-6 shadow-sm sm:p-10 lg:p-12">
    <div class="grid gap-10 lg:grid-cols-[0.95fr_1.05fr] lg:items-start lg:gap-14">
      <div>
        <p class="section-eyebrow mb-4">{t("开始使用")}</p>
        <h2 class="font-heading text-3xl font-bold leading-snug tracking-tight text-heading sm:text-4xl">
          {en ? 'A clearer desktop starts here.' : <><span class="block">从今天开始，</span><span class="block">给桌面留点余地。</span></>}
        </h2>
        <ul class="mt-5 space-y-2.5 text-sm text-muted">
          {perks.map(perk => (
            <li class="flex items-start gap-2.5 leading-6">
              <Check size={16} className="mt-1 shrink-0 text-primary dark:text-blue-300" aria-hidden="true"/>
              <span>{perk}</span>
            </li>
          ))}
        </ul>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <Button variant="primary" text={t("前往 GitHub 下载")} icon="download" href="https://github.com/Yuch3nE/luciddesk/releases/latest"/>
          <Button variant="secondary" text={en ? 'Installation guide' : '安装与更新指南'} href={localizedPath("/installation/", lang)}/>
        </div>
        <p class="mt-4 max-w-sm text-xs leading-6 text-muted">
          {en
            ? 'On the release page, open Assets and choose a package using the filename endings on the right. All three editions have identical features.'
            : '在发布页展开 Assets，按右侧文件名后缀选择发布包。三种发布包功能完全一致。'}
        </p>
      </div>

      <div class="space-y-3">
        {editions.map(({ Icon, title, recommended, filename, configPath, description }) => (
          <div class:list={[
            'motion-card rounded-2xl border p-5 transition-colors',
            recommended
              ? 'border-primary/30 bg-primary/[0.04] dark:border-blue-400/30 dark:bg-blue-400/[0.07]'
              : 'border-line bg-page/75'
          ]}>
            <div class="flex flex-wrap items-center justify-between gap-2.5">
              <h3 class="flex items-center gap-2.5 text-base font-semibold text-heading">
                <span class:list={[
                  'flex size-8 items-center justify-center rounded-lg',
                  recommended
                    ? 'bg-primary/15 text-primary dark:bg-blue-400/20 dark:text-blue-300'
                    : 'bg-surface text-primary dark:text-blue-300'
                ]}>
                  <Icon size={16} aria-hidden="true"/>
                </span>
                <span>{title}</span>
              </h3>
              {recommended && (
                <Badge className="rounded-full border-0 bg-primary/14 px-2.5 py-0.5 text-[11px] font-semibold text-primary dark:bg-blue-400/20 dark:text-blue-300">
                  {t("日常使用推荐")}
                </Badge>
              )}
            </div>
            <p class="mt-2.5 text-sm leading-6 text-muted">{description}</p>
            <div class="mt-3.5 flex flex-wrap items-center gap-2 text-xs">
              <code class="rounded-md border border-line bg-elevated px-2.5 py-1 font-medium text-heading">{filename}</code>
              <span class="text-muted">· {en ? 'Config:' : '配置：'} <code class="text-[11px] text-default">{configPath}</code></span>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-8 flex flex-col justify-between gap-4 border-t border-line pt-6 text-xs text-muted sm:flex-row sm:items-center">
      <p>{en ? 'All three packages support signed in-app updates from Settings → About.' : '三种发布包均支持在「设置 → 关于」中进行签名应用内更新。'}</p>
      <div class="flex flex-wrap gap-5 font-medium text-default">
        <a class="underline decoration-line underline-offset-4 hover:text-primary hover:decoration-primary" href={localizedPath("/changelog/", lang)}>{en ? 'What’s new' : '查看更新内容'}</a>
        <a class="underline decoration-line underline-offset-4 hover:text-primary hover:decoration-primary" href={localizedPath("/installation/#updates", lang)}>{t("安装与更新指南")}</a>
      </div>
    </div>
  </div>
</Section>

<style>
.download-shell {
  background-image: radial-gradient(44% 64% at 0% 0%, rgb(37 99 235 / .07), transparent 72%);
}
:global(.dark) .download-shell {
  background-image: radial-gradient(44% 64% at 0% 0%, rgb(59 130 246 / .12), transparent 72%);
}
</style>
