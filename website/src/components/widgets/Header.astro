---
import { localeOf, translator, localizedPath } from '~/lib/i18n';
const lang = localeOf(Astro.url.pathname);
const t = translator(lang);

import LanguageLink from '~/components/LanguageLink';
import ThemeToggle from "~/components/ThemeToggle";
import RepositoryLink from "~/components/RepositoryLink";
---
<header class="site-header sticky top-0 z-30 border-b">
  <div class="flex items-center justify-between mx-auto max-w-6xl flex-wrap gap-y-2 px-5 py-3 sm:px-8">
    <div class="flex items-center w-auto flex-1"><a href={localizedPath("/", lang)} class="flex items-center gap-2.5 text-xl font-bold tracking-tight" aria-label={t("LucidDesk 首页")}><img src="/assets/app-icon.png" width="34" height="34" alt="">LucidDesk</a></div>
    <nav class="flex items-center order-3 w-full justify-center border-t border-line pt-1 md:order-none md:w-auto md:border-0 md:pt-0" aria-label={t("主导航")}><ul class="flex flex-wrap justify-center gap-x-4 gap-y-2 py-3 text-xs sm:text-sm"><li><a href={localizedPath("/#features", lang)}>{t("功能")}</a></li><li><a href={localizedPath("/#agent", lang)}>{t("Agent 联动")}</a></li><li><a href={localizedPath("/#download", lang)}>{t("下载")}</a></li><li><a href={localizedPath("/guide/", lang)}>{t("使用指南")}</a></li><li><a href={localizedPath("/changelog/", lang)}>{lang === "en" ? "Changelog" : "更新日志"}</a></li></ul></nav>
    <div class="flex items-center justify-end w-auto gap-1 md:flex-1"><LanguageLink lang={lang}/><ThemeToggle lang={lang} client:load /><RepositoryLink lang={lang} className="hidden xl:inline-flex" /></div>
  </div>
</header>
