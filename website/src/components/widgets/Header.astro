---
import { localeOf, translator, localizedPath } from '~/lib/i18n';
import LanguageLink from '~/components/LanguageLink';
import ThemeToggle from '~/components/ThemeToggle';
import RepositoryLink from '~/components/RepositoryLink';
const lang = localeOf(Astro.url.pathname);
const t = translator(lang);
const pathname = Astro.url.pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const links = [
  {href: '/#features', label: lang === 'en' ? 'Features' : '功能', active: pathname.startsWith('/features')},
  {href: '/#agent', label: t('Agent 联动'), active: pathname.startsWith('/agent')},
  {href: '/#download', label: t('下载'), active: pathname.startsWith('/installation')},
  {href: '/guide/', label: t('使用指南'), active: pathname.startsWith('/guide')},
  {href: '/changelog/', label: lang === 'en' ? 'Changelog' : '更新日志', active: pathname.startsWith('/changelog')},
];
---
<header class="site-header sticky top-0 z-30 border-b">
  <div class="site-header-inner">
    <a href={localizedPath('/', lang)} class="site-brand" aria-label={t('LucidDesk 首页')}>
      <img src="/assets/app-icon.png" width="32" height="32" alt=""/>LucidDesk
    </a>
    <nav class="site-nav" aria-label={t('主导航')}>
      <ul>{links.map((link, index) => <li><a href={localizedPath(link.href, lang)} data-page={['/features', '/agent', '/installation', '/guide', '/changelog'][index]} aria-current={link.active ? 'page' : undefined}>{link.label}</a></li>)}</ul>
    </nav>
    <div class="header-tools">
      <RepositoryLink lang={lang} compact className="header-repository"/>
      <span class="header-tool-divider" aria-hidden="true"></span>
      <LanguageLink lang={lang}/>
      <ThemeToggle lang={lang} client:load/>
    </div>
  </div>
</header>
