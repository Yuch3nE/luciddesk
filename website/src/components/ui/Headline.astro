---
import type { Headline as Props } from '~/types';
import { twMerge } from 'tailwind-merge';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  classes = {},
} = Astro.props;

const {
  container: containerClass = 'max-w-2xl',
  title: titleClass = 'text-3xl md:text-4xl',
  subtitle: subtitleClass = 'text-base md:text-lg',
} = classes;
---

{
  (title || subtitle || tagline) && (
    <div data-motion class={twMerge('mb-8 md:mx-auto md:mb-9 text-center', containerClass)}>
      {tagline && (
        <p class="mb-3 text-xs text-primary dark:text-blue-300 font-semibold tracking-widest" set:html={tagline} />
      )}
      {title && (
        <h2
          class={twMerge(
            'font-bold leading-snug tracking-tight font-heading text-heading text-3xl text-balance',
            titleClass
          )}
          set:html={title}
        />
      )}

      {subtitle && <p class={twMerge('mt-4 text-muted text-pretty', subtitleClass)} set:html={subtitle} />}
    </div>
  )
}
