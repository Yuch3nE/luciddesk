---
import { localeOf } from '~/lib/i18n';
import { ChevronDown, Ellipsis, ArrowLeft, House, Folder, FileText } from 'lucide-react';
const en = localeOf(Astro.url.pathname) === 'en';
const pick = (zh: string, english: string) => en ? english : zh;
const files = [pick('设计素材','Design'),pick('项目资料','Projects'),pick('工作计划','Work plan'),pick('参考图片','References'),pick('会议记录','Notes'),pick('已归档','Archive')];
---
<div class="desktop-scene" role="img" aria-label={pick('桌面面板界面示意：居中标题、网格图标和文件夹列表。并非实际截图。','Desktop panel illustration with centered titles, grid icons and a folder list. Not a screenshot.')}>
  <div class="scene-caption">{pick('留给眼前的事，一个清晰的桌面。','A little room for what matters.')}</div>
  <div class="scene-panel main-panel">
    <div class="panel-heading"><strong>{pick('工作项目','Projects')}</strong><span><ChevronDown size={17}/><Ellipsis size={17}/></span></div>
    <div class="panel-files">{files.map((name,i) => <div class="panel-file">{i < 2 || i === 5 ? <Folder size={34} strokeWidth={1.4} className="folder-icon"/> : <FileText size={34} strokeWidth={1.4} className="document-icon"/>}<span>{name}</span></div>)}</div>
  </div>
  <div class="scene-panel folder-panel">
    <div class="panel-heading"><span class="folder-navigation"><ArrowLeft size={14}/><House size={14}/></span><strong>{pick('资料库','Library')}</strong><span><ChevronDown size={15}/><Ellipsis size={15}/></span></div>
    <div class="folder-columns"><span>{pick('文件名','Name')}</span><span>{pick('类型','Type')}</span></div>
    {[pick('品牌素材','Brand assets'),pick('产品文档','Documents'),pick('参考资料','Resources')].map(name => <div class="folder-row"><Folder size={20} className="folder-icon"/><span>{name}</span><small>{pick('文件夹','Folder')}</small></div>)}
  </div>
  <div class="scene-footnote">{pick('界面示意 · 效果随系统与设置变化','UI illustration · Appearance varies by system and settings')}</div>
</div>
<style>
.desktop-scene { position:relative; isolation:isolate; width:100%; aspect-ratio:1.4; overflow:hidden; border-radius:24px; border:1px solid var(--aw-color-line); background:linear-gradient(135deg,var(--illustration-base),var(--illustration-tint)); color:var(--aw-color-text-heading); }
.scene-caption { position:absolute; top:7%; left:7%; right:7%; font-size:clamp(11px,1.15vw,14px); letter-spacing:.04em; }
.scene-panel { position:absolute; background:var(--illustration-panel); border:1px solid var(--aw-color-line); border-radius:10px; box-shadow:0 12px 28px -20px rgb(0 0 0 / .25); }
.main-panel { left:7%; top:17%; width:72%; }
.panel-heading { position:relative; margin:0 8px; height:43px; border-bottom:1px solid var(--aw-color-line); display:flex; align-items:center; justify-content:center; }
.panel-heading strong { font-size:13px; font-weight:600; }
.panel-heading > span { position:absolute; right:2px; display:flex; gap:9px; }
.panel-heading > .folder-navigation { left:2px; right:auto; gap:6px; opacity:.65; }
.panel-files { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:22px 4px; padding:22px 8px 26px; }
.panel-file { display:flex; flex-direction:column; gap:7px; align-items:center; font-size:11px; }
.folder-icon { color:var(--illustration-folder-stroke); fill:var(--illustration-folder-fill); }
.document-icon { color:var(--illustration-document-stroke); fill:var(--illustration-document-fill); }
.folder-panel { width:66%; right:5%; bottom:12%; }
.folder-columns { display:flex; justify-content:space-between; padding:7px 14px; margin:0 8px; border-bottom:1px solid var(--aw-color-line); font-size:10px; opacity:.7; }
.folder-row { display:flex; align-items:center; gap:8px; padding:7px 16px; font-size:11px; }
.folder-row:last-child { padding-bottom:13px; }
.folder-row small { margin-left:auto; font-size:10px; opacity:.65; }
.scene-footnote { position:absolute; bottom:4%; left:7%; right:5%; font-size:10px; opacity:.75; }
/* Scale panel details together while keeping the compact, overlapping composition. */
.desktop-scene { container-type:inline-size; }
.panel-heading { height:7cqw; }
.panel-heading strong { font-size:2.3cqw; }
.panel-heading :global(svg) { width:2.8cqw; height:2.8cqw; }
.panel-files { gap:3cqw 1cqw; padding:3cqw 1.5cqw 4cqw; }
.panel-file { gap:1.2cqw; font-size:2cqw; }
.panel-file :global(svg) { width:5.5cqw; height:5.5cqw; }
.folder-panel { bottom:8%; }
.folder-columns { font-size:1.8cqw; padding:1.1cqw 2cqw; }
.folder-row { font-size:2cqw; padding:1cqw 2.7cqw; gap:1.3cqw; }
.folder-row :global(svg) { width:3.4cqw; height:3.4cqw; }
.folder-row small { font-size:1.8cqw; }
.folder-row:last-child { padding-bottom:2cqw; }
.scene-footnote { bottom:2%; font-size:1.7cqw; }
</style>
